{
  "version": 2,
  "builds": [
    {
      "src": "sajilo-blog/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "sajilo-blog/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "sajilo-blog/dist/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "sajilo-blog/dist/index.html"
    }
  ]
}
